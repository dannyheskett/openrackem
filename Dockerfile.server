# The openrackem multiplayer daemon, packaged for fly.io (see fly.toml).
# Static musl build in an alpine stage, shipped FROM scratch: the final image
# is just the ~100 KB binary. The daemon needs no filesystem, no shell, and
# no TLS (Fly's edge terminates it).
FROM alpine:3.22 AS build
RUN apk add --no-cache gcc musl-dev make
WORKDIR /src
COPY Makefile ./
COPY src/ src/
COPY src-server/ src-server/
RUN make server SERVER_CFLAGS=-static && strip build/orserverd

FROM scratch
COPY --from=build /src/build/orserverd /orserverd
EXPOSE 8080
ENTRYPOINT ["/orserverd"]
