<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>openrackem</string>
    <key>CFBundleDisplayName</key>
    <string>openrackem</string>
    <key>CFBundleIdentifier</key>
    <string>com.danheskett.openrackem</string>
    <key>CFBundleExecutable</key>
    <string>Openrackem</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Placeholders. The device build overwrites both from the release number
         (see IOS_BUILD_NUMBER in the Makefile); App Store Connect rejects an
         upload whose CFBundleVersion is not greater than the previous one. -->
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- 15.0: the UILaunchScreen dict below needs iOS 14+, and Apple's
         ITMS-90068 requires 15.0+ for all uploads from Spring 2027. iOS 15
         runs on the iPhone 6s and later, so this costs no realistic users. -->
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <!-- The online client connects over wss:// (src/net_apple.mm), so the app
         DOES use encryption, but only the TLS the OS provides, for standard
         secure comms, which is exempt. This key asks about NON-exempt
         encryption, so false is the correct answer, and declaring it stops App
         Store Connect asking the export-compliance question on every upload.
         (No crypto ships in the iOS binary: Network.framework terminates TLS,
         and the bundled OpenSSL is an Android-only dependency.) -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
    <!-- Not the whole story: the device build injects CFBundleSupportedPlatforms,
         DTPlatformName, UIRequiredDeviceCapabilities (arm64) and the toolchain
         DT* keys, and merges actool's CFBundleIcons/CFBundleIconName. See the
         $(IOS_IPA) rule in the Makefile. -->
</dict>
</plist>
